#include <stdio.h>
#include <string.h>

int main() {
    char s[1000];

    scanf("%s", s);

    int n = strlen(s);
    int maxLength = 0;

    for (int i = 0; i < n; i++) {
        int visited[256] = {0};
        int length = 0;

        for (int j = i; j < n; j++) {

            // If character is already present
            if (visited[(unsigned char)s[j]] == 1) {
                break;
            }

            visited[(unsigned char)s[j]] = 1;
            length++;

            if (length > maxLength) {
                maxLength = length;
            }
        }
    }

    printf("%d", maxLength);

    return 0;
}
