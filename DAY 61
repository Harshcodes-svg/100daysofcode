#include <stdio.h>

int main() {
    int n, k;

    // Input size of array
    scanf("%d", &n);

    int arr[n];

    // Input array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Input window size
    scanf("%d", &k);

    // Check every subarray of size k
    for (int i = 0; i <= n - k; i++) {

        int found = 0;

        // Find first negative number in current window
        for (int j = i; j < i + k; j++) {

            if (arr[j] < 0) {
                printf("%d ", arr[j]);
                found = 1;
                break;
            }
        }

        // If no negative number was found
        if (found == 0) {
            printf("0 ");
        }
    }

    return 0;
}
